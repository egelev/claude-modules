{
  "name": "claude-modules",
  "version": "0.1.0",
  "description": "Composable plugin modules for Claude Code, applied across user/project/local scopes",
  "type": "module",
  "bin": {
    "claude-modules": "dist/claude-modules.js"
  },
  "scripts": {
    "dev": "CLAUDE_MODULES_HOME=. tsx src/claude-modules.ts",
    "build": "tsc",
    "postbuild": "chmod +x dist/claude-modules.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "tar": "^7.5.22"
  }
}
