{
  "name": "claude-modules",
  "version": "1.0.3",
  "description": "Composable plugin modules for Claude Code, applied across user/project/local scopes",
  "keywords": [
    "claude",
    "claude-code",
    "plugins",
    "plugin-manager",
    "cli",
    "modules",
    "marketplace",
    "developer-tools"
  ],
  "homepage": "https://github.com/egelev/claude-modules#readme",
  "bugs": {
    "url": "https://github.com/egelev/claude-modules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egelev/claude-modules.git"
  },
  "license": "MIT",
  "author": "Emil Gelev",
  "type": "module",
  "bin": {
    "claude-modules": "dist/claude-modules.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "CLAUDE_MODULES_HOME=. tsx src/claude-modules.ts",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/claude-modules.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "tar": "^7.5.22"
  }
}
